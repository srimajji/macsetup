#!/bin/bash

set -uo pipefail

REPO_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
readonly REPO_ROOT
readonly HOMEBREW_BIN="/opt/homebrew/bin/brew"
readonly HOMEBREW_ZSH="/opt/homebrew/bin/zsh"
readonly FNM_BIN="/opt/homebrew/bin/fnm"
failures=0

pass() {
  printf 'PASS: %s\n' "$1"
}

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

skip() {
  printf 'SKIP: %s\n' "$1"
}

warn() {
  printf 'WARN: %s\n' "$1" >&2
}

check_command() {
  local label="$1"
  shift

  if "$@"; then
    pass "$label"
  else
    fail "$label"
  fi
}

check_managed_link() {
  local source="$1"
  local destination="$2"

  if [[ -L "$destination" && "$destination" -ef "$source" ]]; then
    pass "managed link ${destination}"
  else
    fail "managed link ${destination} -> ${source}"
  fi
}

check_checkout_warning() {
  local branch

  if [[ ! -d "${HOME}/.macsetup/.git" ]]; then
    warn "${HOME}/.macsetup is not a Git checkout"
    return
  fi

  if ! branch="$(/usr/bin/git -C "${HOME}/.macsetup" symbolic-ref --quiet --short HEAD)"; then
    warn "${HOME}/.macsetup is detached"
  elif [[ "$branch" != "main" ]]; then
    warn "${HOME}/.macsetup is on branch ${branch}, not main"
  fi

  if [[ -n "$(/usr/bin/git -C "${HOME}/.macsetup" status --porcelain)" ]]; then
    warn "${HOME}/.macsetup has uncommitted changes"
  fi
}

if (( $# != 0 )); then
  printf '%s\n' 'usage: doctor' >&2
  exit 64
fi

if [[ -n "${MAC_SETUP_SKIP_ACCOUNT_SHELL:-}" && "${MAC_SETUP_SKIP_ACCOUNT_SHELL}" != "1" ]]; then
  printf '%s\n' 'MAC_SETUP_SKIP_ACCOUNT_SHELL must be unset or 1' >&2
  exit 64
fi

if [[ "$(/usr/bin/uname -s)" == "Darwin" ]]; then
  pass 'operating system is Darwin'
else
  fail 'operating system is Darwin'
fi

if [[ "$(/usr/bin/uname -m)" == "arm64" ]]; then
  pass 'architecture is arm64'
else
  fail 'architecture is arm64'
fi

macos_version="$(/usr/bin/sw_vers -productVersion 2>/dev/null || true)"
macos_major="${macos_version%%.*}"
if [[ "$macos_major" =~ ^[0-9]+$ ]] && (( macos_major >= 26 )); then
  pass "macOS major is at least 26 (${macos_version})"
else
  fail "macOS major is at least 26 (${macos_version:-unknown})"
fi

check_command 'Command Line Tools path is available' /usr/bin/xcode-select -p

if [[ -x "$HOMEBREW_BIN" ]]; then
  pass "Homebrew is executable at ${HOMEBREW_BIN}"
  eval "$("$HOMEBREW_BIN" shellenv)"
else
  fail "Homebrew is executable at ${HOMEBREW_BIN}"
fi

if [[ -x "$HOMEBREW_ZSH" ]]; then
  pass "Homebrew Zsh is executable at ${HOMEBREW_ZSH}"
else
  fail "Homebrew Zsh is executable at ${HOMEBREW_ZSH}"
fi

if [[ "${MAC_SETUP_SKIP_ACCOUNT_SHELL:-}" == "1" ]]; then
  skip "exactly one ${HOMEBREW_ZSH} entry in /etc/shells"
  skip "account shell is ${HOMEBREW_ZSH}"
else
  shells_count="$(/usr/bin/grep -Fxc "$HOMEBREW_ZSH" /etc/shells || true)"
  if [[ "$shells_count" == "1" ]]; then
    pass "exactly one ${HOMEBREW_ZSH} entry in /etc/shells"
  else
    fail "exactly one ${HOMEBREW_ZSH} entry in /etc/shells (found ${shells_count})"
  fi

  account_user="${USER:-$(/usr/bin/id -un)}"
  account_shell="$(/usr/bin/dscl . -read "/Users/${account_user}" UserShell 2>/dev/null || true)"
  if [[ "$account_shell" == "UserShell: ${HOMEBREW_ZSH}" ]]; then
    pass "account shell is ${HOMEBREW_ZSH}"
  else
    fail "account shell is ${HOMEBREW_ZSH} (${account_shell:-missing})"
  fi
fi

if [[ -x "$HOMEBREW_BIN" ]]; then
  check_command 'Brewfile package contract is installed' \
    "$HOMEBREW_BIN" bundle check --file "$REPO_ROOT/Brewfile" --verbose
else
  fail 'Brewfile package contract is installed'
fi

check_managed_link "$REPO_ROOT/dotfiles/.zprofile" "${HOME}/.zprofile"
check_managed_link "$REPO_ROOT/dotfiles/.zshrc" "${HOME}/.zshrc"
check_managed_link "$REPO_ROOT/dotfiles/.zsh_helpers.zsh" "${HOME}/.zsh_helpers.zsh"
check_managed_link "$REPO_ROOT/dotfiles/.zsh_plugins.txt" "${HOME}/.zsh_plugins.txt"
check_managed_link "$REPO_ROOT/dotfiles/.config/starship.toml" "${HOME}/.config/starship.toml"
check_managed_link "$REPO_ROOT/dotfiles/.config/nvim/init.lua" "${HOME}/.config/nvim/init.lua"
check_managed_link "$REPO_ROOT/dotfiles/.config/nvim/nvim-pack-lock.json" "${HOME}/.config/nvim/nvim-pack-lock.json"

check_command 'fnm is available' "$FNM_BIN" --version
check_command 'default Node is available through fnm' "$FNM_BIN" exec --using=default node --version
check_command 'default Node reports an LTS release' \
  "$FNM_BIN" exec --using=default node -e 'if (!process.release.lts) process.exit(1)'
check_command 'default npm is available through fnm' "$FNM_BIN" exec --using=default npm --version

if [[ -s "${HOME}/.zsh_plugins.zsh" ]]; then
  pass 'generated Antidote bundle exists'
else
  fail 'generated Antidote bundle exists'
fi

expected_plugins=(
  'Aloxaf/fzf-tab'
  'zsh-users/zsh-autosuggestions'
  'zsh-users/zsh-history-substring-search'
  'zdharma-continuum/fast-syntax-highlighting kind:defer'
)
for plugin in "${expected_plugins[@]}"; do
  if /usr/bin/grep -Fqx "$plugin" "${HOME}/.zsh_plugins.txt" 2>/dev/null; then
    pass "Antidote declaration ${plugin}"
  else
    fail "Antidote declaration ${plugin}"
  fi
done

check_command 'eza is available' /opt/homebrew/bin/eza --version
check_command 'GitHub CLI is available' /opt/homebrew/bin/gh --version
check_command 'Starship is available' /opt/homebrew/bin/starship --version
check_command 'Starship configuration parses' env \
  "STARSHIP_CONFIG=${HOME}/.config/starship.toml" /opt/homebrew/bin/starship print-config

# These expressions intentionally expand only inside the child Zsh.
# shellcheck disable=SC2016
if TERM=xterm-256color "$HOMEBREW_ZSH" -ic 'whence -w prompt_starship_precmd >/dev/null' </dev/null; then
  pass 'Starship prompt hook loads in interactive Zsh'
else
  fail 'Starship prompt hook loads in interactive Zsh'
fi

# shellcheck disable=SC2016
if "$HOMEBREW_ZSH" -fc 'source "$HOME/.zsh_helpers.zsh" || exit 1
  [[ "$(alias ls)" == *"eza -l --icons=auto"* ]] || exit 1
  [[ "${aliases[macsetup]}" == *HOME*.macsetup* ]] || exit 1
  for helper in c ccd _resolve_fzf_colorscheme f v mkd o; do
    whence -w "$helper" >/dev/null || exit 1
  done'; then
  pass 'required shell aliases and functions load'
else
  fail 'required shell aliases and functions load'
fi

check_command 'Neovim starts headlessly' /opt/homebrew/bin/nvim --headless '+qall'
check_checkout_warning

if (( failures != 0 )); then
  printf 'Doctor found %d failure(s).\n' "$failures" >&2
  exit 1
fi

printf '%s\n' 'Doctor passed.'
