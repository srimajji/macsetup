#!/bin/bash

set -euo pipefail

# AWS credential_process helper that aws-setup writes into every generated profile.
#
# It first asks saml2aws for credentials in headless Chrome, which reuses the
# saved Google session without showing a window. Only when that fails or times
# out (Google wants a real sign-in, or 2FA) does it rerun saml2aws with a
# visible Chrome window so you can sign in. Cached, unexpired credentials are
# returned by saml2aws straight away in either case.

readonly SAML2AWS=/opt/homebrew/bin/saml2aws
readonly SAML2AWS_CONFIG="${HOME}/.saml2aws"
# A silent refresh normally takes about 3 seconds; headless saml2aws waits
# forever when Google shows a sign-in page, so cap it.
readonly HEADLESS_TIMEOUT_SECONDS=25

if (( $# != 3 )); then
  printf '%s\n' 'usage: aws-credentials <saml2aws-account> <role-arn> <profile>' >&2
  exit 64
fi

account="$1"
role_arn="$2"
profile="$3"

# saml2aws only caches credential_process credentials when given a custom
# credentials file (Versent/saml2aws#895); without it every AWS call signs in again.
readonly CREDENTIALS_CACHE="${HOME}/.aws/saml2aws/credentials"

login_args=(
  login -a "$account"
  --credential-process --skip-prompt --quiet
  --role "$role_arn"
  --profile "saml-${profile}"
  --credentials-file "$CREDENTIALS_CACHE"
)

# saml2aws creates its saved Google session (cookies) world-readable; it keeps
# the mode when it rewrites the file, so tightening it on every run is enough.
readonly GOOGLE_SESSION="${HOME}/.aws/saml2aws/storageState.json"

cleanup() {
  /bin/rm -f "$headless_config"
  if [[ -f "$GOOGLE_SESSION" ]]; then /bin/chmod 600 "$GOOGLE_SESSION"; fi
}

headless_config="$(/usr/bin/mktemp)"
trap cleanup EXIT
/usr/bin/sed -E 's/^(headless[[:space:]]*=).*/\1 true/' "$SAML2AWS_CONFIG" > "$headless_config"

# -k: if saml2aws ignores the first signal, kill it (and its Chrome) 5 seconds later.
if credentials="$(/usr/bin/timeout -k 5 "$HEADLESS_TIMEOUT_SECONDS" \
    "$SAML2AWS" --config "$headless_config" "${login_args[@]}" </dev/null 2>/dev/null)"; then
  printf '%s\n' "$credentials"
  exit 0
fi

printf '%s\n' 'aws-credentials: silent refresh failed; opening Chrome to sign in with Google' >&2
# Not exec: the EXIT trap still has to run after the visible sign-in.
"$SAML2AWS" "${login_args[@]}"
